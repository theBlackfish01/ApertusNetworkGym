# Copy to .env and fill in. Never commit .env (it is gitignored).
# LLM_* names are the ones the Hack Apertus template asks for.

# Model the endpoint serves (the text-only conversion of Apertus v1.5 8B; see SPEC.md section 2).
LLM_NAME=andreasmartin/apertus-v1.5-8b-text

# OpenAI-compatible endpoint, e.g. http://localhost:8000/v1 for vLLM.
# Leave empty and `make run` only rebuilds the results table from results/ (no live demo).
LLM_BASE_URL=

# API key for that endpoint (any non-empty string for a local vLLM server).
LLM_API_KEY=

# Hugging Face token: model download, HF Jobs training, pushing the adapter and dataset.
HF_TOKEN=
